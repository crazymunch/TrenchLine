datasource db {
  provider = "postgresql"

  // The POOLED connection, used by the running app.
  //
  // Every serverless invocation opens its own connection, so a direct endpoint
  // means a fresh Postgres backend per request. Neon's pooler (`-pooler` in the
  // host) hands out a pooled one instead. `pgbouncer=true` belongs on this URL:
  // the pooler runs PgBouncer in TRANSACTION mode, which returns the connection
  // after each transaction and so cannot keep prepared statements alive.
  url = env("DATABASE_URL")

  // The DIRECT connection, used by migrate, diff and studio.
  //
  // Not a duplicate of the above and not optional. A migration takes
  // session-level locks and sets session state, and both are exactly what
  // transaction-mode pooling throws away — run through the pooler they fail,
  // intermittently and confusingly. Set it to the same value as `url` wherever
  // there is no pooler at all, which is every local and CI database.
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Who may act as an application administrator.
///
/// Authorization used to be derived from an ADDRESS — a constant list in
/// `auth.ts`, later `TRENCHLINE_ADMIN_EMAILS`. That closed the takeover chain
/// but left authority attached to a mutable, user-supplied field with no
/// record of who granted it or when.
enum UserRole {
  USER
  ADMIN
}

model User {
  id               String               @id @default(cuid())
  name             String?
  email            String?              @unique
  emailVerified    DateTime?
  password         String?
  image            String?
  /// The persisted grant. Defaulted, never null, so the EXPAND step needs no
  /// backfill to be readable and old code that does not select it is unaffected.
  role             UserRole             @default(USER)
  /// When the role was last changed, and by whom — the evidence an email list
  /// could not provide. Null on a user whose role has never been set.
  roleGrantedAt    DateTime?
  /// The `User.id` of the actor who set it, or the literal `bootstrap` for the
  /// one-shot promotion that creates the first administrator. Not a relation:
  /// an audit trail must survive the granting account being deleted.
  roleGrantedBy    String?
  /// Bumped to revoke this user's stateless JWTs — a password reset, for
  /// instance — without rotating `NEXTAUTH_SECRET` and signing everybody out.
  /// The token carries the epoch it was issued under and is refused when it
  /// no longer matches.
  sessionEpoch     Int                  @default(0)
  authTokens       AuthToken[]
  accounts         Account[]
  sessions         Session[]
  warbands         Warband[]
  campaignMembers  CampaignMember[]
  createdCampaigns Campaign[]           @relation("CreatedCampaigns")
  customRules      CustomRuleOverride[]
  bugReports       BugReport[]
  hostedMatches    LiveMatch[]
  /// Battles this account recorded — the device that ran the tracker.
  recordedBattles  Battle[]
  /// Battles this account's warbands FOUGHT IN, which is how a game reaches
  /// the other players in a 2v2 rather than only the one who tracked it.
  battlesFought    BattleParticipant[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

/// What a single-use token is for. One model serves both, because they have
/// identical security properties — hashed at rest, expiring, single use — and
/// two nearly-identical tables is two places to get that wrong.
enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// A single-use, expiring token sent to an address.
///
/// The RAW token is never stored. What is stored is a SHA-256 of it, so a read
/// of this table — a backup, a log, a compromised replica — does not hand
/// anyone the ability to verify an address or reset a password. The raw value
/// exists only in the mail that was sent and in the link the user clicks.
///
/// NextAuth's own `VerificationToken` is left alone: it stores the token in
/// clear, and it is keyed by identifier rather than by user.
model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the raw token, hex. Unique so a lookup is a single indexed read
  /// and a collision cannot silently resolve to the wrong row.
  tokenHash String           @unique
  purpose   AuthTokenPurpose
  expiresAt DateTime
  /// Set the moment it is spent. Single use is enforced on this, not on
  /// deletion, so a replayed link can be told apart from one that never existed.
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, purpose])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Whether a roster appears in the public Warband Directory.
///
/// PRIVATE is the default and the migration backfills every existing row to
/// it. The directory used to show every roster that had ever synced to the
/// cloud — nobody opted in, and the response carried the owner's email
/// address, private notes, campaign snapshots and sync metadata with it.
/// Backfilling to PUBLIC would preserve exactly that non-consensual
/// publication, so the directory starts empty and fills as people choose.
enum WarbandVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

// Trench Crusade Application Models
model Warband {
  id              String            @id @default(cuid())
  name            String
  factionId       String
  ducatLimit      Int               @default(700)
  treasuryDucats  Int               @default(0)
  gloryPoints     Int               @default(0)
  units           Json              @default("[]")
  armoryStash     Json              @default("[]")
  notes           String?           @db.Text
  visibility      WarbandVisibility @default(PRIVATE)
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignMembers CampaignMember[]

  /// SH-1. The public share link's token, or null when the roster is not shared.
  ///
  /// Nullable and UNIQUE, which is the whole schema decision: a token is what a
  /// reader presents instead of a session, so two rosters must never answer to
  /// one, and "not shared" has to be a state the column can hold. Postgres
  /// treats NULLs as distinct under a unique index, so every unshared roster is
  /// simply null.
  ///
  /// RANDOM, never derived from the id. `warbandCode(id)` is derived and is
  /// printed in the builder for anyone to read out; a token derived the same way
  /// would make every roster in the database publicly readable the moment one
  /// person shared theirs.
  ///
  /// A real column rather than a key in the `notes` metadata JSON, unlike
  /// `editedAt` — see the note in `src/app/api/warbands/route.ts`. The share page
  /// looks a roster up BY this value with no session, so it has to be indexed
  /// and unique; a JSON key cannot be either.
  shareToken      String?           @unique
  createdAt       DateTime          @default(now())

  // When this row was last written, set by Prisma. A PUSH time, not an edit
  // time — which is the trap: sync used to compare it, so a device that merely
  // opened the app made its copies look newer than another device's real work.
  //
  // `editedAt`, the time the PLAYER last changed the roster and the field the
  // sync merge actually compares, is deliberately NOT a column here. It rides
  // in the `notes` metadata JSON with the other client-owned fields. See the
  // note in src/app/api/warbands/route.ts for why.
  updatedAt DateTime @updatedAt
}

model Campaign {
  id                    String           @id @default(cuid())
  name                  String
  inviteCode            String           @unique
  adminId               String
  admin                 User             @relation("CreatedCampaigns", fields: [adminId], references: [id], onDelete: Cascade)
  status                String           @default("active")
  currentTurn           Int              @default(1)
  maxWarbandDucats      Int              @default(700)
  gloryVictoryThreshold Int              @default(25)
  chronicleLogs         Json             @default("[]")
  /// Which rules this campaign is played under — `classic` or `carcass-front`.
  /// The database had no concept of one, which is half of why a campaign in
  /// the app was never the campaign in the database (docs/CAMPAIGN-SYNC.md).
  framework             String?
  /// House rules this campaign has chosen, one key per relaxed rule. Mirrors
  /// `Campaign.houseRules` in the client; see `CampaignHouseRules`.
  houseRules            Json?
  /// Monotonic, bumped on every accepted write.
  ///
  /// Conflicts are decided on the version an edit was MADE against, not on
  /// when it arrived: receipt order is a property of the network rather than
  /// of the work, so two devices on one flaky connection would otherwise have
  /// the slower one silently win.
  version               Int              @default(1)
  members               CampaignMember[]
  matches               MatchRecord[]
  territories           TerritoryNode[]
  syncOps               CampaignSyncOp[]
  liveMatches           LiveMatch[]
  battles               Battle[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

/// One applied sync operation, remembered so a repeat is skipped.
///
/// This is the property the deleted fire-and-forget code lacked: it called
/// create on every attempt, which is how one campaign became several. A retry
/// is only safe if the server can recognise it, so the client generates the
/// `opId` and the server records it.
model CampaignSyncOp {
  /// Client-generated. The primary key IS the idempotency: a second insert of
  /// the same operation is a constraint violation rather than a second write.
  opId       String   @id
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// What it did, for an operator reading the table after an incident.
  kind       String
  /// Who the server attributed it to — never taken from the request body.
  actorId    String
  appliedAt  DateTime @default(now())

  @@index([campaignId, appliedAt])
}

/// A game in progress, as ONE device holds it.
///
/// LIVE-1, and the shape is the whole design — see docs/LIVE-MODE.md. This is
/// a SNAPSHOT, not a stream of operations, and that is what makes it small:
/// a watcher does not need to know how the board reached its state, only what
/// it is, so a dropped update is repaired by the next one and the ordering,
/// replay and idempotency machinery `CampaignSyncOp` exists for never arises.
///
/// It is deliberately NOT modelled on campaign sync. That protocol resolves a
/// conflict by asking a human, which is not an answer mid-activation, and it
/// is tuned for a handful of edits an evening rather than dozens a minute.
model LiveMatch {
  /// Client-minted, like a campaign's cloud id and for the same reason: the
  /// host writes before it knows the server has heard, so a lost response must
  /// be retried under an id the client already holds rather than producing a
  /// second match.
  id         String   @id
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// The one account whose device is authoritative. Nobody else may write, and
  /// this is the whole authority model — see the table in docs/CAMPAIGN-SYNC.md.
  hostId     String
  host       User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  /// Bumped on every accepted write. Served as the ETag, so a watcher polling
  /// a quiet table costs a 304 rather than a snapshot.
  revision   Int      @default(1)
  /// The board: per-model wounds, status, markers and whether it has acted,
  /// plus the turn. Bounded by the route, not by this column.
  state      Json
  startedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Which games are live in a campaign, newest first. More than one may be:
  /// two pairs of players at one club night are two matches, each with its own
  /// host, and a single-match-per-campaign key would have made them collide.
  @@index([campaignId, updatedAt])
}

model CampaignMember {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  warbandId   String
  warband     Warband  @relation(fields: [warbandId], references: [id], onDelete: Cascade)
  playerName  String
  warbandName String
  factionId   String
  glory       Int      @default(0)
  rating      Int      @default(0)
  wins        Int      @default(0)
  losses      Int      @default(0)
  draws       Int      @default(0)
  treasury    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([campaignId, warbandId])
}

model MatchRecord {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date         String
  scenarioId   String
  scenarioName String
  narrativeLog String   @db.Text
  participants Json     @default("[]")
  createdAt    DateTime @default(now())
}

model TerritoryNode {
  /// Minted by the CLIENT when a campaign is published, not by the database.
  ///
  /// Publishing has to be idempotent: the client sends the whole map in one
  /// request, and if the response is lost the retry must not produce a second
  /// copy of the campaign. That is the same property `CampaignSyncOp.opId`
  /// buys, bought the same way — the primary key is the idempotency, so a
  /// repeat is a constraint violation rather than a second write.
  ///
  /// `@default(cuid())` stays for the four starting territories the API still
  /// creates for a campaign made server-side.
  id                     String   @id @default(cuid())
  campaignId             String
  campaign               Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// The id this territory has on the device: `wt-*`, `th-*`, `cf-<slug>`.
  ///
  /// Stable and meaningful — `cf-<slug>` is derived from the published zone
  /// name — but NOT unique across campaigns, which is why it cannot be the
  /// primary key. It is carried so the client can join a server row back to
  /// its own without holding a mapping, and the constraint below is what makes
  /// that join single-valued.
  ///
  /// Null on a territory the API created for itself.
  localId                String?
  name                   String
  type                   String
  controlledByWarbandId  String?
  controlledByPlayerName String?
  perk                   String
  /// `published`, `campaign`, or absent.
  ///
  /// The difference between a rule the books state and one this group wrote,
  /// which the app has drawn since the sixteen invented perks came out of
  /// `seed.ts` and the database has not. A published perk is writable by
  /// nobody — see the authority table in docs/CAMPAIGN-SYNC.md.
  perkSource             String?
  description            String   @db.Text
  /// Monotonic, bumped on every accepted write. See `Campaign.version`.
  version                Int      @default(1)

  /// One row per local id per campaign.
  ///
  /// Not merely an index. Without it a retried publish that somehow reached
  /// the create path twice would produce two rows the client cannot tell
  /// apart, and every later `territory.perk` operation would update whichever
  /// the query happened to return first.
  @@unique([campaignId, localId])
}

/// A bug report.
///
/// These lived in a module-level array: they vanished on restart, differed
/// between server instances, silently capped at 100, and were readable in
/// full — reporter addresses included — by any unauthenticated GET. The
/// reporter's identity came from `body.userEmail`, so it was whatever the
/// submitter typed.
model BugReport {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  severity    String
  area        String?
  status      String   @default("open")
  /// Null for an anonymous report. Set from the SESSION, never from the body.
  reporterId  String?
  reporter    User?    @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model CustomRuleOverride {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleType  String // 'unit' | 'weapon' | 'armour' | 'equipment'
  ruleId    String
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, ruleType, ruleId])
}

/// Who may read a battle record.
///
/// Three values, not a boolean, because "shared" has two meanings here and
/// they are not the same decision. A battle is normally interesting to the
/// people who fought it and to the campaign it belongs to; that it should be
/// readable by strangers is a further, separate choice.
///
/// `PUBLIC` is in the enum and is NOT reachable from the UI yet — see the note
/// on the route. A schema that cannot express it would have to be migrated
/// again to gain it; a UI that cannot set it costs nothing.
enum BattleVisibility {
  PRIVATE
  CAMPAIGN
  PUBLIC
}

/// One battle, as it stood when the match ended.
///
/// The cloud half of docs/CHRONICLE.md. The record itself is built on the
/// device by `rules/battleFromMatch.ts` and is **immutable** — a chronicle you
/// can revise is a chronicle nobody trusts — so this table is written once per
/// battle and thereafter only read or deleted. There is no version column and
/// no merge, because there is no second writer: unlike a roster, a finished
/// battle is not edited from two devices.
///
/// The columns that are columns rather than JSON are the ones something
/// queries or sorts by. The rest of the record rides as JSON, in the shape
/// `types/battle.ts` validates on the way back in — the client re-parses what
/// the server returns rather than trusting the column types, because a row
/// written by an older build is exactly the case `parseBattle` exists for.
model Battle {
  /// Minted by the CLIENT, like a campaign's cloud id and `LiveMatch.id`: the
  /// device writes the record when the match ends, possibly with no signal at
  /// the table, so a retry has to land on an id it already holds rather than
  /// producing a second copy of the same game. The primary key IS the
  /// idempotency.
  id              String              @id
  /// The account whose device recorded it, from the SESSION and never the
  /// body. The only account that may delete it.
  ownerId         String
  owner           User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Set when the match was fought inside a synced campaign. A one-off game
  /// between friends has none, and is still shared with its participants.
  campaignId      String?
  campaign        Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  visibility      BattleVisibility    @default(CAMPAIGN)
  /// When the match ENDED, which is what the Chronicle sorts by — not when the
  /// row reached the server. A phone that recorded a battle offline and pushed
  /// it two days later must not sort above a game played since.
  endedAt         DateTime
  scenarioId      String
  scenarioName    String
  turns           Int
  /// `BattleSide[]` — name, faction, VP, per-turn scores, coalition.
  sides           Json
  /// `DeedClaim[]` — title, description AS PRINTED ON THE NIGHT, who claimed
  /// it and on which turn.
  deeds           Json                @default("[]")
  coalitionTotals Json?
  weather         Json?
  participants    BattleParticipant[]
  createdAt       DateTime            @default(now())

  @@index([campaignId, endedAt])
  @@index([ownerId, endedAt])
  @@index([visibility, endedAt])
}

/// One side of a battle, joined to the account that owns that warband.
///
/// This exists so that "battles I fought in" is an indexed lookup rather than
/// a JSON scan of every row in the table. It is also the thing that makes a
/// battle reach the other players at all: the device that ran the tracker is
/// the only one that recorded anything, and without this the other three
/// warbands in a 2v2 would have no way to find the game they played.
///
/// `userId` is resolved SERVER-SIDE from warband ownership at write time and
/// is null for a placeholder opponent, who has no account by definition. It is
/// not taken from the body: a client that could name the participants could
/// name anyone, and a battle appearing in a stranger's Chronicle is a write to
/// their account by someone else.
model BattleParticipant {
  id        String  @id @default(cuid())
  battleId  String
  battle    Battle  @relation(fields: [battleId], references: [id], onDelete: Cascade)
  /// The warband's id as the record holds it. For a placeholder side this is
  /// the `opp-*` id, which is local to the recording device and matches no
  /// row — kept anyway so the join is total and a side is never silently
  /// dropped.
  warbandId String
  /// The warband's owner, or null where the warband is not one this service
  /// knows. Null is the honest answer, not a fallback to the recorder.
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([battleId, warbandId])
  @@index([userId])
}
