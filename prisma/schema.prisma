datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Who may act as an application administrator.
///
/// Authorization used to be derived from an ADDRESS — a constant list in
/// `auth.ts`, later `TRENCHLINE_ADMIN_EMAILS`. That closed the takeover chain
/// but left authority attached to a mutable, user-supplied field with no
/// record of who granted it or when.
enum UserRole {
  USER
  ADMIN
}

model User {
  id               String               @id @default(cuid())
  name             String?
  email            String?              @unique
  emailVerified    DateTime?
  password         String?
  image            String?
  /// The persisted grant. Defaulted, never null, so the EXPAND step needs no
  /// backfill to be readable and old code that does not select it is unaffected.
  role             UserRole             @default(USER)
  /// When the role was last changed, and by whom — the evidence an email list
  /// could not provide. Null on a user whose role has never been set.
  roleGrantedAt    DateTime?
  /// The `User.id` of the actor who set it, or the literal `bootstrap` for the
  /// one-shot promotion that creates the first administrator. Not a relation:
  /// an audit trail must survive the granting account being deleted.
  roleGrantedBy    String?
  accounts         Account[]
  sessions         Session[]
  warbands         Warband[]
  campaignMembers  CampaignMember[]
  createdCampaigns Campaign[]           @relation("CreatedCampaigns")
  customRules      CustomRuleOverride[]
  bugReports       BugReport[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Whether a roster appears in the public Warband Directory.
///
/// PRIVATE is the default and the migration backfills every existing row to
/// it. The directory used to show every roster that had ever synced to the
/// cloud — nobody opted in, and the response carried the owner's email
/// address, private notes, campaign snapshots and sync metadata with it.
/// Backfilling to PUBLIC would preserve exactly that non-consensual
/// publication, so the directory starts empty and fills as people choose.
enum WarbandVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

// Trench Crusade Application Models
model Warband {
  id              String            @id @default(cuid())
  name            String
  factionId       String
  ducatLimit      Int               @default(700)
  treasuryDucats  Int               @default(0)
  gloryPoints     Int               @default(0)
  units           Json              @default("[]")
  armoryStash     Json              @default("[]")
  notes           String?           @db.Text
  visibility      WarbandVisibility @default(PRIVATE)
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignMembers CampaignMember[]
  createdAt       DateTime          @default(now())

  // When this row was last written, set by Prisma. A PUSH time, not an edit
  // time — which is the trap: sync used to compare it, so a device that merely
  // opened the app made its copies look newer than another device's real work.
  //
  // `editedAt`, the time the PLAYER last changed the roster and the field the
  // sync merge actually compares, is deliberately NOT a column here. It rides
  // in the `notes` metadata JSON with the other client-owned fields. See the
  // note in src/app/api/warbands/route.ts for why.
  updatedAt DateTime @updatedAt
}

model Campaign {
  id                    String           @id @default(cuid())
  name                  String
  inviteCode            String           @unique
  adminId               String
  admin                 User             @relation("CreatedCampaigns", fields: [adminId], references: [id], onDelete: Cascade)
  status                String           @default("active")
  currentTurn           Int              @default(1)
  maxWarbandDucats      Int              @default(700)
  gloryVictoryThreshold Int              @default(25)
  chronicleLogs         Json             @default("[]")
  members               CampaignMember[]
  matches               MatchRecord[]
  territories           TerritoryNode[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model CampaignMember {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  warbandId   String
  warband     Warband  @relation(fields: [warbandId], references: [id], onDelete: Cascade)
  playerName  String
  warbandName String
  factionId   String
  glory       Int      @default(0)
  rating      Int      @default(0)
  wins        Int      @default(0)
  losses      Int      @default(0)
  draws       Int      @default(0)
  treasury    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([campaignId, warbandId])
}

model MatchRecord {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date         String
  scenarioId   String
  scenarioName String
  narrativeLog String   @db.Text
  participants Json     @default("[]")
  createdAt    DateTime @default(now())
}

model TerritoryNode {
  id                     String   @id @default(cuid())
  campaignId             String
  campaign               Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name                   String
  type                   String
  controlledByWarbandId  String?
  controlledByPlayerName String?
  perk                   String
  description            String   @db.Text
}

/// A bug report.
///
/// These lived in a module-level array: they vanished on restart, differed
/// between server instances, silently capped at 100, and were readable in
/// full — reporter addresses included — by any unauthenticated GET. The
/// reporter's identity came from `body.userEmail`, so it was whatever the
/// submitter typed.
model BugReport {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  severity    String
  area        String?
  status      String   @default("open")
  /// Null for an anonymous report. Set from the SESSION, never from the body.
  reporterId  String?
  reporter    User?    @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model CustomRuleOverride {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleType  String // 'unit' | 'weapon' | 'armour' | 'equipment'
  ruleId    String
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, ruleType, ruleId])
}
