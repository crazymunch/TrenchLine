{
  "name": "trenchline",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "rules:fetch": "node scripts/rules-fetch.mjs",
    "rules:pdfs": "node scripts/rules-fetch-pdfs.mjs",
    "rules:crosscheck": "node scripts/rules-crosscheck.mjs",
    "rules:warbands": "node scripts/parse-warbands-pdf.mjs",
    "rules:threeway": "node scripts/rules-threeway.mjs",
    "rules:audit": "node scripts/audit-wargear.mjs",
    "rules:build": "node scripts/rules-build.mjs",
    "rules:check": "node scripts/rules-build.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "rules:extract": "node scripts/extract-pdf.mjs",
    "icons:build": "node scripts/build-app-icons.mjs",
    "postinstall": "prisma generate",
    "rules:audit:campaign": "node scripts/rules-audit-campaign.mjs",
    "test:e2e": "playwright test",
    "test:e2e:phone": "playwright test --project=phone",
    "lint:fix": "eslint . --fix",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:verify": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$DATABASE_URL\" --exit-code"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "diff": "^7.0.0",
    "fast-xml-parser": "^4.5.3",
    "lucide-react": "^1.16.0",
    "next": "^15.1.0",
    "next-auth": "^4.24.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/diff": "^7.0.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.3",
    "postcss": "^8.5.26",
    "prisma": "^5.22.0",
    "sharp": "0.35.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
