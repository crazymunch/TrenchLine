# TrenchLine server environment.
#
# Names and descriptions only — never real values. Copy to `.env.local` for
# development, and set the same names in the host's secret store for a
# deployment.
#
# `src/lib/env.ts` is the single place that reads the required ones, and it
# throws on startup when one is missing rather than substituting a default.
# There used to be a fallback signing secret written into `src/lib/auth.ts`,
# which meant a deployment that forgot to set one booted successfully and
# signed its sessions with a key published in this repository.

# ---------------------------------------------------------------- required

# Signs and verifies session JWTs. Generate one PER ENVIRONMENT:
#
#     openssl rand -base64 32
#
# Rotating it invalidates every existing session, which is how sessions are
# revoked after an incident. Never share one between environments: a
# development secret that leaks is then a production secret that leaked.
NEXTAUTH_SECRET=

# Postgres connection string. Prisma needs it to generate a client at build
# time; nothing connects during the build itself.
# The POOLED connection, used by the running app. On Neon that is the host with
# `-pooler` in it, plus `pgbouncer=true` because the pooler runs PgBouncer in
# transaction mode and cannot hold prepared statements open.
DATABASE_URL=
# The DIRECT connection, used by `prisma migrate`, `diff` and `studio`, which
# take session-level locks that transaction-mode pooling discards. Set it to the
# same value as DATABASE_URL for any database with no pooler in front of it —
# every local and CI one. `prisma generate` does not need it, so a deployment
# that forgets it still builds and serves; only migrations fail.
DIRECT_DATABASE_URL=

# ---------------------------------------------------------------- optional

# The canonical URL of the deployment, e.g. https://trenchline.example.
# NextAuth infers it on Vercel; set it explicitly anywhere else.
# The public origin this deployment is served from, used by robots.txt and
# sitemap.xml. Optional: `siteUrl()` falls back to NEXTAUTH_URL and then to
# Vercel's production domain, and throws if none is set — there is deliberately
# no default, because a sitemap naming the wrong origin is one a search engine
# reads and believes. Set it when the canonical public origin differs from
# where auth runs.
NEXT_PUBLIC_SITE_URL=

NEXTAUTH_URL=

# Google sign-in. The provider is only registered when BOTH are present, so
# leaving them blank simply means the app offers password sign-in alone.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated addresses that hold the application admin role. Setting it
# REPLACES the built-in default outright rather than adding to it, so this is
# also how the default is dropped.
#
# Interim: email is a poor identity for a role, and this exists so the grant is
# a deployment decision that can be changed and revoked without a release. A
# persisted, auditable role on the user record is what retires it.
#
# `commander@trenchline.org` must never be listed here. It is the identity the
# signed-out API routes used to share, so it is an address a stranger could
# bring into existence.
TRENCHLINE_ADMIN_EMAILS=

# ------------------------------------------------------------ seeding only

# Optional password for the demo user that `prisma/seed.ts` creates. Left
# unset, the demo account is seeded with NO password and cannot be signed into,
# which is the intended default — the seed used to hard-code a working
# credential for an account that was also an admin.
SEED_DEMO_PASSWORD=
